<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DashboardSectionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandHeaderForeground}" />
        <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
        <Setter Property="Margin" Value="0,24,0,12" />
    </Style>

    <Style x:Key="DashboardCardPanelStyle" TargetType="WrapPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="DashboardEmptyStateStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeCard}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>

    <Style x:Key="DashboardEmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource BrandTextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DashboardLoadingOverlayStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

</ResourceDictionary>
