<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.25" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HealthCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="MinHeight" Value="140" />
    </Style>

    <Style x:Key="CostCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="MinHeight" Value="140" />
    </Style>

    <Style x:Key="QrCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="MinHeight" Value="160" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandTextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="CardValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandHeaderForeground}" />
        <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
    </Style>

    <Style x:Key="CardSubValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource BrandTextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="HealthIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
