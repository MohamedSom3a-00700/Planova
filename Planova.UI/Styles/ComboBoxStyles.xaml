<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1E1E2E" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#3A3A5C" />
    <SolidColorBrush x:Key="ComboBoxToggleHoverBackground" Color="#2A2A4A" />
    <SolidColorBrush x:Key="ComboBoxTogglePressedBackground" Color="#32324A" />
    <SolidColorBrush x:Key="ComboBoxArrowFill" Color="#B0B0C8" />
    <SolidColorBrush x:Key="ComboBoxArrowHoverFill" Color="#00BFFF" />
    <SolidColorBrush x:Key="ComboBoxItemHoverBackground" Color="#2A2A4A" />
    <SolidColorBrush x:Key="ComboBoxItemSelectedBackground" Color="#0078D4" />
    <SolidColorBrush x:Key="ComboBoxItemSelectedForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxItemDisabledForeground" Color="#6E6E8E" />
    <SolidColorBrush x:Key="ComboBoxEmptyStateForeground" Color="#6E6E8E" />

    <CornerRadius x:Key="ComboBoxCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ComboBoxItemCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ComboBoxPopupCornerRadius">8</CornerRadius>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ThemeCard}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandHeaderForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BrandBodySize}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ComboBoxCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  IsHitTestVisible="False"/>
                                <ToggleButton x:Name="DropDownToggle"
                                              ClickMode="Press"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Margin="0"
                                              Padding="0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Stretch"
                                              Width="32"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder"
                                                    Background="Transparent"
                                                    CornerRadius="0,6,6,0"
                                                    Padding="0">
                                                <Path x:Name="Arrow"
                                                      Data="M0,0 L4,4 L8,0 Z"
                                                      Fill="{DynamicResource ComboBoxArrowFill}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      StrokeThickness="0"
                                                      Margin="0,0,0,1"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ComboBoxToggleHoverBackground}"/>
                                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ComboBoxArrowHoverFill}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ComboBoxTogglePressedBackground}"/>
                                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ComboBoxArrowHoverFill}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ComboBoxItemDisabledForeground}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Slide"
                               VerticalOffset="4"
                               HorizontalOffset="-1">
                            <Border x:Name="PopupBorder"
                                    Background="{DynamicResource ComboBoxDropDownBackground}"
                                    BorderBrush="{DynamicResource ComboBoxDropDownBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ComboBoxPopupCornerRadius}"
                                    Margin="0,4,0,0"
                                    SnapsToDevicePixels="True"
                                    >
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.20" Color="#000000"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              MinHeight="50"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="True"
                                              Padding="4">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ThemeSurface}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ThemeSurface}"/>
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource BrandBorderSubtle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrandTextSecondary}"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PopupBorder" Property="MinHeight" Value="36"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
        <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BrandBodySize}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource ComboBoxItemCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboBoxItemHoverBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForeground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboBoxItemSelectedBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemSelectedForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemDisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
