<UserControl x:Class="Planova.UI.Views.Dashboard.HealthCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:vm="clr-namespace:Planova.UI.ViewModels.Dashboard"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              d:DataContext="{d:DesignInstance vm:HealthCardViewModel}"
              mc:Ignorable="d">
    <Border Style="{StaticResource HealthCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:SymbolIcon Symbol="Heart24" FontSize="28" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="1" Text="{Binding ProjectName}" Style="{StaticResource CardTitleStyle}"/>

            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding ScheduleHealthPct, StringFormat='Schedule: {0:F1}%'}"
                           Style="{StaticResource CardSubValueStyle}"/>
                <TextBlock Text="{Binding CostHealthPct, StringFormat='Cost: {0:F1}%'}"
                           Style="{StaticResource CardSubValueStyle}"/>
                <TextBlock Text="{Binding RiskLevel, StringFormat='Risk: {0}'}"
                           Style="{StaticResource CardSubValueStyle}"/>
                <TextBlock Text="{Binding CriticalActivityCount, StringFormat='Critical: {0}'}"
                           Style="{StaticResource CardSubValueStyle}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{Binding HealthIndicator}"
                       Foreground="{DynamicResource BrandTextSecondary}"
                       FontSize="12" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</UserControl>
