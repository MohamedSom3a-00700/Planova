<UserControl x:Class="Planova.UI.Views.Dashboard.DashboardView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:vm="clr-namespace:Planova.UI.ViewModels"
              xmlns:dvm="clr-namespace:Planova.UI.ViewModels.Dashboard"
              xmlns:conv="clr-namespace:Planova.UI.Converters"
              xmlns:dash="clr-namespace:Planova.UI.Views.Dashboard"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
              mc:Ignorable="d"
             Background="{DynamicResource DashboardBackgroundGradient}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <DataTemplate x:Key="DistributionItemTemplate" DataType="{x:Type dvm:DistributionSummaryItem}">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                <Border Width="12" Height="12" CornerRadius="2"
                        Background="{Binding Color}"
                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Label}"
                           Foreground="{DynamicResource BrandTextSecondary}"
                           FontFamily="{DynamicResource BrandFontFamily}"/>
                <TextBlock Text="{Binding Count, StringFormat=': {0}'}"
                           Foreground="{DynamicResource BrandHeaderForeground}"
                           FontWeight="SemiBold" Margin="2,0,0,0"
                           FontFamily="{DynamicResource BrandFontFamily}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="{DynamicResource BrandSpacingLarge}">
                <TextBlock Text="Dashboard"
                           Style="{StaticResource DashboardTitleStyle}"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource BrandDanger}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                           Margin="0,8,0,0"/>

                <Border Style="{StaticResource DashboardEmptyStateStyle}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No projects yet — create your first project"
                               Style="{StaticResource DashboardEmptyStateTextStyle}"/>
                </Border>

                <WrapPanel Margin="0,24,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flag24" FontSize="24" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalProjects}"
                                       Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="Projects"
                                       Style="{StaticResource KpiLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="People24" FontSize="24" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalClients}"
                                       Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="Clients"
                                       Style="{StaticResource KpiLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Document24" FontSize="24" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalContracts}"
                                       Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="Contracts"
                                       Style="{StaticResource KpiLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Notepad24" FontSize="24" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalBoqs}"
                                       Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="BOQs"
                                       Style="{StaticResource KpiLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Layer24" FontSize="24" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalWbsEntries}"
                                       Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="WBS"
                                       Style="{StaticResource KpiLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="List24" FontSize="24" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalActivities}"
                                       Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="Activities"
                                       Style="{StaticResource KpiLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="PersonCircle24" FontSize="24" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalResources}"
                                       Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="Resources"
                                       Style="{StaticResource KpiLabelStyle}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <TextBlock Text="Project Health" Style="{StaticResource DashboardSectionStyle}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}"/>
                <ItemsControl ItemsSource="{Binding HealthCards}"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Style="{StaticResource DashboardCardPanelStyle}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dvm:HealthCardViewModel}">
                            <dash:HealthCardView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Cost &amp; Performance" Style="{StaticResource DashboardSectionStyle}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}"/>
                <ItemsControl ItemsSource="{Binding CostCards}"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Style="{StaticResource DashboardCardPanelStyle}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dvm:CostCardViewModel}">
                            <dash:CostCardView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Status Distribution" Style="{StaticResource PlanovaSectionHeaderStyle}"/>
                <ItemsControl ItemsSource="{Binding StatusDistributionItems}" Margin="0,0,0,8"
                              ItemTemplate="{StaticResource DistributionItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="BOQ Status" Style="{StaticResource PlanovaSectionHeaderStyle}"/>
                <ItemsControl ItemsSource="{Binding BoqDistributionItems}" Margin="0,0,0,8"
                              ItemTemplate="{StaticResource DistributionItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="WBS Status" Style="{StaticResource PlanovaSectionHeaderStyle}"/>
                <ItemsControl ItemsSource="{Binding WbsDistributionItems}" Margin="0,0,0,8"
                              ItemTemplate="{StaticResource DistributionItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="Activity Status" Style="{StaticResource PlanovaSectionHeaderStyle}"/>
                <ItemsControl ItemsSource="{Binding ActivityDistributionItems}" Margin="0,0,0,8"
                              ItemTemplate="{StaticResource DistributionItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="Resource Types" Style="{StaticResource PlanovaSectionHeaderStyle}"/>
                <ItemsControl ItemsSource="{Binding ResourceTypeDistributionItems}" Margin="0,0,0,16"
                              ItemTemplate="{StaticResource DistributionItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="Quick Actions" Style="{StaticResource PlanovaSectionHeaderStyle}"/>
                <WrapPanel>
                    <Button Content="+ New Project" Command="{Binding NavigateToProjectsCommand}"
                            Style="{StaticResource ActionTileStyle}"/>
                    <Button Content="+ New Client" Command="{Binding NavigateToClientsCommand}"
                            Style="{StaticResource ActionTileStyle}"/>
                    <Button Content="+ New Contract" Command="{Binding NavigateToContractsCommand}"
                            Style="{StaticResource ActionTileStyle}"/>
                    <Button Content="+ Open BOQ" Command="{Binding NavigateToBoqCommand}"
                            Style="{StaticResource ActionTileStyle}"/>
                    <Button Content="+ Open WBS" Command="{Binding NavigateToWbsCommand}"
                            Style="{StaticResource ActionTileStyle}"/>
                    <Button Content="+ Open Schedule" Command="{Binding NavigateToActivityCommand}"
                            Style="{StaticResource ActionTileStyle}"/>
                    <Button Content="+ Open Resources" Command="{Binding NavigateToResourceCommand}"
                            Style="{StaticResource ActionTileStyle}"/>
                </WrapPanel>

                <TextBlock Text="Recent Activity" Style="{StaticResource PlanovaSectionHeaderStyle}" Margin="0,24,0,8"/>
                <Border Style="{StaticResource CardSurfaceStyle}" MaxHeight="300">
                    <ListView ItemsSource="{Binding RecentActivity}"
                              BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding EntityType}" FontWeight="SemiBold" Width="80"
                                               Foreground="{DynamicResource BrandHeaderForeground}"
                                               FontFamily="{DynamicResource BrandFontFamily}"/>
                                    <TextBlock Text="{Binding EntityName}" Width="200"
                                               Foreground="{DynamicResource BrandHeaderForeground}"
                                               FontFamily="{DynamicResource BrandFontFamily}"/>
                                    <TextBlock Text="{Binding Action}" Width="80"
                                               Foreground="{DynamicResource BrandTextSecondary}"
                                               FontFamily="{DynamicResource BrandFontFamily}"/>
                                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:g}}"
                                               Foreground="{DynamicResource BrandTextSecondary}"
                                               FontFamily="{DynamicResource BrandFontFamily}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Style="{StaticResource DashboardLoadingOverlayStyle}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Loading dashboard data..."
                           Style="{StaticResource DashboardEmptyStateTextStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
