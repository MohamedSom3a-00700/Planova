<UserControl x:Class="Planova.UI.Views.Dashboard.QrCodeCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Planova.UI.ViewModels.Dashboard"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Planova.UI.Converters"
             d:DataContext="{d:DesignInstance vm:QrCodeCardViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True"/>
        <conv:FilePathToImageConverter x:Key="FilePathToImage"/>
    </UserControl.Resources>
    <Border Style="{StaticResource QrCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:SymbolIcon Symbol="QrCode24" FontSize="28" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="1" Text="{Binding ProjectName}" Style="{StaticResource CardTitleStyle}"/>

            <Grid Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="{Binding QrCodePath, Converter={StaticResource FilePathToImage}}"
                       Width="128" Height="128" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <Trigger Property="Source" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasData, Converter={StaticResource InvertedBoolToVis}}">
                    <ui:SymbolIcon Symbol="QrCode24" FontSize="36" Foreground="{DynamicResource BrandTextSecondary}"
                                   HorizontalAlignment="Center" Opacity="0.4"/>
                    <TextBlock Text="No QR code yet" FontSize="12"
                               Foreground="{DynamicResource BrandTextSecondary}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3" Text="{Binding GoogleMapsLink}"
                       FontSize="11" Foreground="{DynamicResource BrandTextSecondary}"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Right"
                       Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Border>
</UserControl>
