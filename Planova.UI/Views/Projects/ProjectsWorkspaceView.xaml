<UserControl x:Class="Planova.UI.Views.Projects.ProjectsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Planova.UI.ViewModels"
             xmlns:conv="clr-namespace:Planova.UI.Converters"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             xmlns:proj="clr-namespace:Planova.UI.Views.Projects"
             d:DataContext="{d:DesignInstance vm:ProjectsWorkspaceViewModel}"
             Background="{DynamicResource WorkspaceBackgroundGradient}"
             FontFamily="{DynamicResource BrandFontFamily}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True"/>
        <conv:LockedDocumentTypeConverter x:Key="LockedDocConverter"/>
        <conv:BytesToKilobytesConverter x:Key="BytesToKilobytesConverter"/>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
        </Style>
        <Style x:Key="DocCountChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ProjectCardListStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" Padding="0" Margin="0,0,0,4"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource ThemeBorder}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="SelectedIndicator"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource ThemeAccent}"
                                        CornerRadius="3,0,0,3"
                                        Visibility="Collapsed"/>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource ThemeCard}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource ThemeCard}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="12">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Folder24" FontSize="24" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Projects" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource ThemeForeground}"/>
            </StackPanel>
            <WrapPanel Margin="0,12,0,0">
                <ui:TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search projects..."
                            ClearButtonEnabled="True"
                            Width="250" Height="28"/>
                <Button Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0" Height="28"/>
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}"
                          Margin="8,0,0,0" Height="28" Width="120"/>
                <Button Content="+ New Project" Click="OnNewProjectClick" Margin="12,0,0,0" Height="28"/>
            </WrapPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column: Project list view -->
            <proj:ProjectListView DataContext="{Binding ListVM}"/>

            <!-- Right column: Editor (create/edit mode) -->
            <Grid Grid.Column="1" Margin="12,0,0,0"
                  Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="New Project" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeAccent}"
                                   Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="Edit Project" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeAccent}"
                                   Visibility="{Binding IsCreating, Converter={StaticResource InvertedBoolToVis}}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Code:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditCode}" Margin="4,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditName}" Margin="4,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Description:"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditDescription}" AcceptsReturn="True" Height="50" Margin="4,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Start Date:" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding EditStartDate}" Margin="4,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Finish Date:" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding EditFinishDate}" Margin="4,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Currency:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Currencies}"
                                      SelectedItem="{Binding EditCurrency}" Margin="4,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Location:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding EditLocation}" Margin="4,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Logo:" VerticalAlignment="Center"/>
                            <Grid Grid.Row="7" Grid.Column="1" Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding LogoPreviewPath, TargetNullValue='No logo selected'}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseLogoCommand}" Margin="4,0,0,0" Height="28"/>
                            </Grid>
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Cover Image:" VerticalAlignment="Center"/>
                            <Grid Grid.Row="8" Grid.Column="1" Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding CoverPreviewPath, TargetNullValue='No cover selected'}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCoverCommand}" Margin="4,0,0,0" Height="28"/>
                            </Grid>
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Client:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding Clients}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding EditSelectedClient}" Margin="4,2"/>
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Contractor:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="10" Grid.Column="1" ItemsSource="{Binding Contractors}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding EditSelectedContractor}" Margin="4,2"/>
                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Subcontractor:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="11" Grid.Column="1" ItemsSource="{Binding Subcontractors}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding EditSelectedSubcontractor}" Margin="4,2"/>
                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Consultant:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="12" Grid.Column="1" ItemsSource="{Binding Consultants}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding EditSelectedConsultant}" Margin="4,2"/>
                            <TextBlock Grid.Row="13" Grid.Column="0" Text="Notes:"/>
                            <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding EditNotes}" AcceptsReturn="True" Height="50" Margin="4,2"/>
                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Documents Folder:" VerticalAlignment="Center"/>
                            <Grid Grid.Row="14" Grid.Column="1" Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding EditDocumentsFolder}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseDocumentsFolderCommand}" Margin="4,0,0,0" Height="28"/>
                            </Grid>
                            <TextBlock Grid.Row="15" Grid.Column="0" Text="Google Maps Link:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="15" Grid.Column="1" Text="{Binding EditGoogleMapsLink}" Margin="4,2"/>
                            <StackPanel Grid.Row="16" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Save" Command="{Binding SaveCommand}" Height="28" Width="80"/>
                                <Button Content="Cancel" Command="{Binding CancelEditCommand}" Margin="8,0,0,0" Height="28" Width="80"/>
                            </StackPanel>
                        </Grid>


                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Right column: Project detail view (read-only mode) -->
            <Grid Grid.Column="1" Margin="12,0,0,0"
                  Visibility="{Binding IsEditing, Converter={StaticResource InvertedBoolToVis}}">
                <proj:ProjectDetailView DataContext="{Binding DetailVM}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
