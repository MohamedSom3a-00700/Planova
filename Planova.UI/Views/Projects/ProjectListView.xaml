<UserControl x:Class="Planova.UI.Views.Projects.ProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Planova.UI.ViewModels.Projects"
             xmlns:conv="clr-namespace:Planova.UI.Converters"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              d:DataContext="{d:DesignInstance vm:ProjectListViewModel}"
             mc:Ignorable="d"
             Background="{DynamicResource WorkspaceBackgroundGradient}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True"/>
        <conv:HealthToColorConverter x:Key="HealthToColor"/>
        <conv:FilePathToImageConverter x:Key="FilePathToImage"/>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <Style x:Key="ProjectContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ThemeCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="16">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Folder24" FontSize="24" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Projects" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource ThemeForeground}"/>
                </StackPanel>

                <Border Style="{StaticResource DashboardEmptyStateStyle}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Folder24" FontSize="48" Foreground="{DynamicResource BrandTextSecondary}"
                                       HorizontalAlignment="Center"/>
                        <TextBlock Text="No projects yet — create your first project"
                                   Style="{StaticResource DashboardEmptyStateTextStyle}"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Projects}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource InvertedBoolToVis}}"
                              Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="300" MinHeight="140" Margin="0,0,10,10"
                                    CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource ThemeBorder}"
                                    Background="{DynamicResource ThemeCard}"
                                    Cursor="Hand"
                                    Padding="0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ThemeCard}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#000000"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Offset="0" Color="#0E2A47"/>
                                                            <GradientStop Offset="1" Color="#162233"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#00BFFF"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="#00BFFF"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.ContextMenu>
                                    <ContextMenu Style="{StaticResource ProjectContextMenuStyle}">
                                        <MenuItem Header="Open Project"
                                                  Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Folder24" FontSize="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Edit Project"
                                                  Command="{Binding DataContext.EditSelectedProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Delete Project"
                                                  Command="{Binding DataContext.DeleteSelectedProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#e74c3c"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="4" CornerRadius="10,0,0,10"
                                            Background="{DynamicResource ThemeAccent}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>

                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                    <!-- Cover area -->
                                    <Border Grid.Row="0" Height="60"
                                            Background="{DynamicResource ThemeAccent}"
                                            CornerRadius="10,10,0,0"
                                            Opacity="0.15">
                                        <Image Source="{Binding CoverImagePath, Converter={StaticResource FilePathToImage}}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding CoverImagePath, Converter={StaticResource BoolToVis}}"/>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="12,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Logo/Avatar -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                                Background="{DynamicResource ThemeSurface}"
                                                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                                VerticalAlignment="Center" Margin="0,-22,0,0">
                                            <Grid>
                                                <Image Source="{Binding LogoPath, Converter={StaticResource FilePathToImage}}"
                                                       Width="40" Height="40" Stretch="Uniform"
                                                       Visibility="{Binding LogoPath, Converter={StaticResource BoolToVis}}"/>
                                                <ui:SymbolIcon Symbol="Folder24" FontSize="20"
                                                               Foreground="{DynamicResource ThemeAccent}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding LogoPath, Converter={StaticResource InvertedBoolToVis}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" Margin="10,6,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Code}" FontSize="11"
                                                           Foreground="{DynamicResource BrandTextSecondary}"/>
                                                <TextBlock Text=" · " FontSize="11"
                                                           Foreground="{DynamicResource BrandTextSecondary}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThemeForeground}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <WrapPanel Margin="0,4,0,0">
                                                <Border Style="{StaticResource StatusBadgeStyle}" Background="{DynamicResource ThemeAccent}">
                                                    <TextBlock Text="{Binding Status}" FontSize="10"
                                                               Foreground="White"/>
                                                </Border>
                                                <Ellipse Width="8" Height="8" Margin="6,5,0,0"
                                                         Fill="{Binding HealthStatus, Converter={StaticResource HealthToColor}}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:P0}'}"
                                                           FontSize="11" Foreground="{DynamicResource ThemeAccent}"
                                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Footer details -->
                                    <Border Grid.Row="2" 
                                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0"
                                            Padding="12,8" CornerRadius="0,0,10,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="11" Foreground="{DynamicResource BrandTextSecondary}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding ClientName, Mode=OneWay, TargetNullValue='No client'}"/>
                                                    <Run Text="·"/>
                                                    <Run Text="{Binding ContractorName, Mode=OneWay, TargetNullValue='No contractor'}"/>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <ui:SymbolIcon Symbol="CalendarDay24" FontSize="10"
                                                                   Foreground="{DynamicResource BrandTextSecondary}"
                                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource BrandTextSecondary}">
                                                        <Run Text="{Binding StartDate, Mode=OneWay, StringFormat='{}{0:MMM dd}'}"/>
                                                        <Run Text="→"/>
                                                        <Run Text="{Binding FinishDate, Mode=OneWay, StringFormat='{}{0:MMM dd, yyyy}'}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Budget, StringFormat='{}{0:N0}'}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThemeAccent}"
                                                           HorizontalAlignment="Right"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                    <ui:SymbolIcon Symbol="Document24" FontSize="10"
                                                                   Foreground="{DynamicResource BrandTextSecondary}"
                                                                   VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource BrandTextSecondary}">
                                                        <Run Text="{Binding DocumentCount, Mode=OneWay}"/>
                                                        <Run Text=" docs"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource DashboardLoadingOverlayStyle}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Loading projects..." VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
