<UserControl x:Class="Planova.UI.Views.Boq.BoqImportOutlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Planova.UI.ViewModels.Boq"
             xmlns:enums="clr-namespace:Planova.Boq.Domain.Enums;assembly=Planova.Boq"
             xmlns:conv="clr-namespace:Planova.UI.Converters"
             d:DataContext="{d:DesignInstance vm:BoqImportOutlineViewModel}"
             mc:Ignorable="d"
             Background="{DynamicResource WorkspaceBackgroundGradient}"
             FontFamily="{DynamicResource BrandFontFamily}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True"/>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="22" Foreground="{DynamicResource ThemeAccent}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="BOQ Outline Preview" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource ThemeForeground}"/>
            </StackPanel>
            <TextBlock Text="Review the BOQ structure before importing — choose to use the selected BOQ or import a new one"
                       FontSize="13" Foreground="{DynamicResource BrandTextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Choice Panel: Use Selected or Import New -->
        <Border Grid.Row="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12"
                Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1"
                Visibility="{Binding ShowChoicePanel, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Choose how to proceed with this BOQ" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="8" Padding="20,16" Margin="0,0,12,0"
                            Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="2"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Width="200">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="24" Foreground="{DynamicResource ThemeAccent}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Use Selected" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeForeground}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Proceed with the current BOQ as imported — view the outline grid below"
                                       FontSize="11" Foreground="{DynamicResource BrandTextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            <Button Content="Use Selected" Command="{Binding UseSelectedCommand}"
                                    HorizontalAlignment="Center" MinWidth="120" Height="32" Margin="0,12,0,0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8" Padding="20,16" Margin="0,0,0,0"
                            Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Width="200">
                            <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="24" Foreground="{DynamicResource ThemeAccent}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Import New" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeForeground}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Import fresh data and rebuild the outline from the source file"
                                       FontSize="11" Foreground="{DynamicResource BrandTextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            <Button Content="Import New" Command="{Binding ImportNewCommand}"
                                    HorizontalAlignment="Center" MinWidth="120" Height="32" Margin="0,12,0,0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Scan Summary Cards -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,8" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
            <Border CornerRadius="8" Padding="12,8" Margin="0,0,8,0"
                    Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Sheets Detected" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}"/>
                    <TextBlock Text="{Binding SheetsDetected}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="12,8" Margin="0,0,8,0"
                    Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="BOQ Sheets" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}"/>
                    <TextBlock Text="{Binding BoqSheetsDetected}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="12,8" Margin="0,0,8,0"
                    Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Skipped (Non-BOQ)" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}"/>
                    <TextBlock Text="{Binding NonBoqSheetsSkipped}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondary}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="12,8" Margin="0,0,8,0"
                    Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Estimated Rows" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}"/>
                    <TextBlock Text="{Binding TotalRows}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Import Mode selector (inline) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"
                     Visibility="{Binding HasPreview, Converter={StaticResource InvertedBoolToVis}}">
            <ComboBox ItemsSource="{Binding ImportModes}" SelectedItem="{Binding SelectedImportMode}"
                      MinWidth="200" Height="36" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding ImportModeLabel}" FontSize="13" Foreground="{DynamicResource BrandTextSecondary}"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{DynamicResource ThemeAccent}"
                       VerticalAlignment="Center" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{DynamicResource BrandDanger}"
                       VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- Outline Grid -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeCard}" CornerRadius="8"
              Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" Padding="4">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Outline tree list -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="4">
                <ItemsControl ItemsSource="{Binding OutlineItems}" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BoqImportOutlineItem}">
                            <Border Background="{DynamicResource ThemeSurface}" CornerRadius="4" Padding="8,6" Margin="0,1,0,1"
                                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0" Symbol="{Binding ItemTypeIcon}" FontSize="14"
                                                    Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Code}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{DynamicResource ThemeForeground}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="12"
                                               Foreground="{DynamicResource ThemeForeground}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="3" Text="{Binding SourceSheet}" FontSize="10"
                                               Foreground="{DynamicResource BrandTextSecondary}" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Visibility="{Binding SourceSheet, Converter={StaticResource BoolToVis}}"/>

                                    <TextBlock Grid.Column="4" Text="{Binding Unit}" FontSize="11"
                                               Foreground="{DynamicResource BrandTextSecondary}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="5" Text="{Binding Quantity, StringFormat='N2'}" FontSize="11"
                                               Foreground="{DynamicResource ThemeForeground}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="6" Text="{Binding Rate, StringFormat='N2'}" FontSize="11"
                                               Foreground="{DynamicResource ThemeForeground}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="7" Text="{Binding DisplayAmount}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource ThemeBorder}" ResizeBehavior="PreviousAndNext"/>

            <!-- Selected item detail panel -->
            <Border Grid.Column="2" Background="{DynamicResource ThemeCard}" Padding="16"
                    CornerRadius="8" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding SelectedItem, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Item Detail" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"
                                   Foreground="{DynamicResource ThemeForeground}"/>

                        <TextBlock Text="Code" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedItem.Code}" Margin="0,0,0,12" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeForeground}"/>

                        <TextBlock Text="Description" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedItem.Description}" Margin="0,0,0,12" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground}"/>

                        <TextBlock Text="Classification" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}" Margin="0,0,0,2"
                                   Visibility="{Binding SelectedItem.Classification, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding SelectedItem.Classification}" Margin="0,0,0,12" FontSize="13"
                                   Foreground="{DynamicResource ThemeAccent}"
                                   Visibility="{Binding SelectedItem.Classification, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="Division" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}" Margin="0,0,0,2"
                                   Visibility="{Binding SelectedItem.Division, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding SelectedItem.Division}" Margin="0,0,0,12" FontSize="13"
                                   Foreground="{DynamicResource ThemeAccent}"
                                   Visibility="{Binding SelectedItem.Division, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="Unit" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedItem.Unit}" Margin="0,0,0,12" FontSize="14" Foreground="{DynamicResource ThemeForeground}"/>

                        <TextBlock Text="Quantity" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedItem.Quantity, StringFormat='N2'}" Margin="0,0,0,12" FontSize="14" Foreground="{DynamicResource ThemeForeground}"/>

                        <TextBlock Text="Rate" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedItem.Rate, StringFormat='N2'}" Margin="0,0,0,12" FontSize="14" Foreground="{DynamicResource ThemeForeground}"/>

                        <TextBlock Text="Amount" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedItem.Amount, StringFormat='N2'}" Margin="0,0,0,12" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeAccent}"/>

                        <TextBlock Text="Source Sheet" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}" Margin="0,0,0,2"
                                   Visibility="{Binding SelectedItem.SourceSheet, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding SelectedItem.SourceSheet}" Margin="0,0,0,12" FontSize="13"
                                   Foreground="{DynamicResource BrandTextSecondary}"
                                   Visibility="{Binding SelectedItem.SourceSheet, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="Item Type" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrandTextSecondary}" Margin="0,0,0,2"/>
                        <Border CornerRadius="4" Padding="6,2" Margin="0,0,0,8"
                                Background="{DynamicResource ThemeAccent}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedItem.ItemType}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccentForeground}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            </Grid>
        </Border>

        <!-- Footer with totals -->
        <Border Grid.Row="4" Background="{DynamicResource ThemeCard}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0"
                BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1"
                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Sections: " FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeForeground}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding TotalSections}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="Rows: " FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeForeground}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding TotalRows}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="Grand Total: " FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource ThemeForeground}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding GrandTotal, StringFormat='N2'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeSurface}" Opacity="0.8" CornerRadius="8"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="32" Foreground="{DynamicResource ThemeAccent}"
                               HorizontalAlignment="Center"/>
                <TextBlock Text="Scanning and building outline..." FontSize="14"
                           Foreground="{DynamicResource BrandTextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
