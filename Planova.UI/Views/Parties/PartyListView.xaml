<UserControl x:Class="Planova.UI.Views.Parties.PartyListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Planova.UI.ViewModels.Parties"
             xmlns:conv="clr-namespace:Planova.UI.Converters"
             d:DataContext="{d:DesignInstance vm:PartyListViewModel}"
             mc:Ignorable="d"
             Background="{DynamicResource WorkspaceBackgroundGradient}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True"/>
        <conv:PartyRoleToIconConverter x:Key="RoleToIcon"/>
        <conv:FilePathToImageConverter x:Key="FilePathToImage"/>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="16">
                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="24" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="Parties" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeForeground}" VerticalAlignment="Center"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource BrandTextSecondary}"
                                       Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">
                                <Run Text="Current project:"/>
                                <Run Text="{Binding ProjectName}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding AddNewCommand}" MinHeight="32" MinWidth="100"
                                Visibility="{Binding IsEditMode, Converter={StaticResource InvBool}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Add Party"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                <!-- Edit Form -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="16"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="18" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding EditTitle}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeForeground}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Logo -->
                        <Border Style="{StaticResource CardSurfaceStyle}" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="6"
                                        Background="Transparent" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
                                    <Grid>
                                        <Image Source="{Binding EditLogoPath, Converter={StaticResource FilePathToImage}}"
                                               Width="60" Height="60" Stretch="Uniform"
                                               Visibility="{Binding EditLogoPath, Converter={StaticResource BoolToVis}}"/>
                                        <ui:SymbolIcon Symbol="Image24" FontSize="28" Foreground="{DynamicResource BrandTextSecondary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding EditLogoPath, Converter={StaticResource InvBool}}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Party Logo" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding EditLogoFileName, TargetNullValue='No image selected'}"
                                               FontSize="11" Foreground="{DynamicResource BrandTextSecondary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding BrowseLogoCommand}" MinHeight="28" MinWidth="70" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Folder24" FontSize="12" Margin="0,0,4,0"/>
                                            <TextBlock Text="Browse"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ClearLogoCommand}" MinHeight="28" MinWidth="28"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTip="Remove logo"
                                            Visibility="{Binding EditLogoPath, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#e74c3c"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="14" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Project" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding ProjectOptions}"
                                          SelectedItem="{Binding SelectedEditProject}"
                                          DisplayMemberPath="Name"
                                          Margin="0,0,0,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="14" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Name" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <TextBox Text="{Binding EditName}" Margin="0,0,0,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Badge24" FontSize="14" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Role" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding AvailableRoles}"
                                          SelectedItem="{Binding EditRole}" Margin="0,0,0,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Call24" FontSize="14" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Contact Person" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <TextBox Text="{Binding EditContactPerson}" Margin="0,0,0,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Mail24" FontSize="14" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Email" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <TextBox Text="{Binding EditContactEmail}" Margin="0,0,0,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Phone24" FontSize="14" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Phone" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <TextBox Text="{Binding EditContactPhone}" Margin="0,0,0,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Location24" FontSize="14" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Address" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <TextBox Text="{Binding EditAddress}" AcceptsReturn="True" MinHeight="40" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}"
                                    MinHeight="32" MinWidth="80" Margin="0,0,8,0"/>
                            <Button Content="Save" Command="{Binding SaveCommand}"
                                    MinHeight="32" MinWidth="100"
                                    Background="{DynamicResource ThemeAccent}" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- List -->
                <Border Style="{StaticResource DashboardEmptyStateStyle}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="48" Foreground="{DynamicResource BrandTextSecondary}"
                                       HorizontalAlignment="Center"/>
                        <TextBlock Text="No parties found"
                                   Style="{StaticResource DashboardEmptyStateTextStyle}"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Parties}"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InvBool}}"
                              Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCardStyle}" MinWidth="340" MinHeight="80" Margin="0,0,8,8" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ThemeForeground}"/>
                                            <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                    Background="{DynamicResource ThemeAccent}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ContactPerson}" FontSize="11"
                                                       Foreground="{DynamicResource BrandTextSecondary}"
                                                       Visibility="{Binding ContactPerson, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text=" · " FontSize="11"
                                                       Foreground="{DynamicResource BrandTextSecondary}"
                                                       Visibility="{Binding ContactEmail, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding ContactEmail}" FontSize="11"
                                                       Foreground="{DynamicResource BrandTextSecondary}"
                                                       Visibility="{Binding ContactEmail, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text=" · " FontSize="11"
                                                       Foreground="{DynamicResource BrandTextSecondary}"
                                                       Visibility="{Binding ContactPhone, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding ContactPhone}" FontSize="11"
                                                       Foreground="{DynamicResource BrandTextSecondary}"
                                                       Visibility="{Binding ContactPhone, Converter={StaticResource BoolToVis}}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ProjectName}" FontSize="10"
                                                   Foreground="{DynamicResource BrandTextSecondary}"
                                                   Visibility="{Binding ProjectName, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    MinWidth="28" MinHeight="28" Margin="0,0,4,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    ToolTip="Edit">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="14" Foreground="{DynamicResource BrandTextSecondary}"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    MinWidth="28" MinHeight="28"
                                                    Background="Transparent" BorderThickness="0"
                                                    ToolTip="Delete">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#e74c3c"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loading -->
                <Border Style="{StaticResource DashboardLoadingOverlayStyle}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Loading parties..." VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
