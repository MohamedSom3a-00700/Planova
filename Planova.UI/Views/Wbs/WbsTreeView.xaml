<UserControl x:Class="Planova.UI.Views.Wbs.WbsTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Planova.UI.ViewModels.Wbs"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:WbsTreeItemNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="4">
                <Rectangle Width="4" Height="16" Fill="{Binding LevelColor}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Name}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding WeightPercent}" Foreground="Gray" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding NodeInfo}" Foreground="SteelBlue" FontStyle="Italic"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox ItemsSource="{Binding AvailableWbsList}"
                      SelectedItem="{Binding SelectedWbs}"
                      DisplayMemberPath="Name"
                      MinWidth="250"
                      ToolTip="Select a WBS to view"/>
            <ComboBox ItemsSource="{Binding ViewModes}"
                      SelectedItem="{Binding ViewMode}"
                      MinWidth="140"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"
                     ToolTip="Search node by name or code"/>
            <Button Content="Search" Command="{Binding SearchNodeCommand}" Margin="0,0,8,0"/>
            <Button Content="Clear" Command="{Binding ClearSearchCommand}" Margin="0,0,16,0"/>
            <Button Content="Expand All" Command="{Binding ExpandAllCommand}" Margin="0,0,8,0"/>
            <Button Content="Collapse All" Command="{Binding CollapseAllCommand}"/>
        </StackPanel>

        <TreeView Grid.Row="3" ItemsSource="{Binding FilteredRootNodes}"
                  VirtualizingPanel.ScrollUnit="Item"
                  VirtualizingPanel.VirtualizationMode="Recycling"/>
    </Grid>
</UserControl>
